{
  "name": "@imbau/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:deploy": "node --experimental-strip-types migrate.ts",
    "db:seed": "node --experimental-strip-types seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1076.0",
    "@imbau/config": "workspace:*",
    "@t3-oss/env-core": "0.13.11",
    "better-auth": "1.6.18",
    "bullmq": "5.78.1",
    "drizzle-orm": "0.45.2",
    "drizzle-zod": "0.8.3",
    "ioredis": "5.10.1",
    "postgres": "3.4.9",
    "uuid": "11.1.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@better-auth/cli": "1.4.21",
    "@types/node": "22.18.13",
    "drizzle-kit": "0.31.10",
    "typescript": "5.9.3"
  }
}
